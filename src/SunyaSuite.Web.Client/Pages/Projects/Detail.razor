@page "/projects/{Id:guid}"
@attribute [Authorize(Policy = PolicyNames.OrgMemberOrAbove)]
@inject IProjectService ProjectService
@inject IInvoiceService InvoiceService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageHeader Title="@(_project?.Name ?? "Project Details")" Icon="@Icons.Material.Filled.FolderOpen" />

<ErrorAlert Message="@_errorMessage"
            OnDismiss="@(() => _errorMessage = null)" />

@if (_loading)
{
    <LoadingSkeleton Variant="SkeletonVariant.DetailCard" />
}
else if (_project is null)
{
    <MudAlert Severity="Severity.Warning" Class="mt-4">Project not found.</MudAlert>
}
else
{
    <MudText Typo="Typo.h4" Class="mb-4">
        @_project.Name
        <StatusChip Status="@_project.Status" />
    </MudText>

    <MudGrid>
        <MudItem xs="12" md="5">
            <DetailInfoCard Title="Project Details"
                            Fields="@(new List<DetailField>
                            {
                                new() { Label = "Client", Value = _project.ClientName, IsLink = true, Href = $"/clients/{_project.ClientId}" },
                                new() { Label = "Status", Value = _project.Status },
                                new() { Label = "Deadline", Value = _project.Deadline.ToString(DateFormats.Display) },
                                new() { Label = "Description", Value = !string.IsNullOrEmpty(_project.Description) ? _project.Description : "—" }
                            })">
                <div class="mt-4">
                    <MudText Typo="Typo.body2" Class="text-secondary mb-1">Progress: @_project.ProgressPercent%</MudText>
                    <MudProgressLinear Value="@_project.ProgressPercent" Class="rounded" Style="max-width: 200px;" />
                </div>
                <div class="d-flex gap-2 mt-4">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Edit"
                               Href="@($"/projects/edit/{_project.Id}")">
                        Edit
                    </MudButton>
                    <MudMenu Icon="@Icons.Material.Filled.SwapHoriz" Label="Change Status" Variant="Variant.Outlined" Size="Size.Small">
                        <MudMenuItem OnClick="@(() => UpdateStatusWithConfirm(ProjectStatus.NotStarted))"
                                     Disabled="@(_project.Status == StatusStrings.ProjectNotStarted)">
                            Not Started
                        </MudMenuItem>
                        <MudMenuItem OnClick="@(() => UpdateStatusWithConfirm(ProjectStatus.InProgress))"
                                     Disabled="@(_project.Status == StatusStrings.ProjectInProgress)">
                            In Progress
                        </MudMenuItem>
                        <MudMenuItem OnClick="@(() => UpdateStatusWithConfirm(ProjectStatus.OnHold))"
                                     Disabled="@(_project.Status == StatusStrings.ProjectOnHold)">
                            On Hold
                        </MudMenuItem>
                        <MudMenuItem OnClick="@(() => UpdateStatusWithConfirm(ProjectStatus.Completed))"
                                     Disabled="@(_project.Status == StatusStrings.ProjectCompleted)">
                            Completed
                        </MudMenuItem>
                    </MudMenu>
                </div>
            </DetailInfoCard>
        </MudItem>
        <MudItem xs="12" md="7">
            <DetailInfoCard Title="Client Information"
                            Fields="@(new List<DetailField>
                            {
                                new() { Label = "Name", Value = _project.ClientName, IsLink = true, Href = $"/clients/{_project.ClientId}" },
                                new() { Label = "Email", Value = _project.ClientEmail ?? "—" },
                                new() { Label = "Phone", Value = !string.IsNullOrEmpty(_project.ClientPhone) ? _project.ClientPhone : "—" }
                            })" />
        </MudItem>
    </MudGrid>

    <MudPaper Elevation="0" Outlined="true" Class="pa-6 mt-6">
        <MudText Typo="Typo.subtitle2" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Timeline" Class="mr-2" />
            Status Timeline
        </MudText>
        @{
            var currentIndex = GetStatusIndex(_project.Status);
        }
        <div class="d-flex align-center flex-wrap status-timeline">
            @foreach (var (status, i) in _statusSteps.Select((s, i) => (s, i)))
            {
                var passed = i <= currentIndex;
                <div class="d-flex align-center" @key="status.Label">
                    <MudAvatar Size="Size.Small"
                               Color="@(passed ? Color.Primary : Color.Default)"
                               Variant="@(passed ? Variant.Filled : Variant.Outlined)">
                        @if (i < currentIndex)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">@(i + 1)</MudText>
                        }
                    </MudAvatar>
                    <MudText Class="ml-2" Typo="Typo.body2"
                             Color="@(passed ? Color.Primary : Color.Default)">
                        @status.Label
                    </MudText>
                </div>
                @if (i < _statusSteps.Count - 1)
                {
                    <div class="status-timeline-connector"></div>
                }
            }
        </div>
    </MudPaper>

    <MudText Typo="Typo.caption" Class="text-secondary mt-2 ml-1">
        Transitions: Not Started → In Progress → Completed. In Progress ↔ On Hold.
    </MudText>

    <MudPaper Elevation="0" Outlined="true" Class="pa-6 mt-6">
        <MudText Typo="Typo.subtitle2" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" />
            Invoices
        </MudText>
        @if (_invoicesLoading)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mt-4" />
        }
        else if (_invoicesError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true">@_invoicesError</MudAlert>
        }
        else if (_invoices.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="text-disabled">No invoices for this client.</MudText>
        }
        else
        {
            <MudTable T="InvoiceListItemDto" Items="@_invoices" Dense="true" Hover="true" Striped="true" Outlined="false" Elevation="0">
                <ColGroup>
                    <col style="width: 28%;" />
                    <col style="width: 24%;" />
                    <col style="width: 24%;" />
                    <col style="width: 24%;" />
                </ColGroup>
                <HeaderContent>
                    <MudTh>Invoice #</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Amount</MudTh>
                    <MudTh>Issue Date</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Invoice #">
                        <MudLink Href="@($"/invoices/{context.Id}")">@context.InvoiceNumber</MudLink>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <StatusChip Status="@context.Status" />
                    </MudTd>
                    <MudTd DataLabel="Amount">@Currency.Format(context.Total)</MudTd>
                    <MudTd DataLabel="Issue Date">@context.IssueDate.ToString(DateFormats.Display)</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private bool _invoicesLoading;
    private string? _errorMessage;
    private string? _invoicesError;
    private ProjectDetailDto? _project;
    private List<InvoiceListItemDto> _invoices = [];

    private readonly List<(ProjectStatus Status, string Label)> _statusSteps =
    [
        (ProjectStatus.NotStarted, "Not Started"),
        (ProjectStatus.InProgress, "In Progress"),
        (ProjectStatus.Completed, "Completed"),
        (ProjectStatus.OnHold, "On Hold"),
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _project = await ProjectService.GetByIdAsync(Id);
            if (_project is not null)
                await LoadInvoicesAsync();
        }
        catch
        {
            _errorMessage = "Failed to load data.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadInvoicesAsync()
    {
        _invoicesLoading = true;
        try
        {
            var filter = new InvoiceFilterDto { ClientId = _project!.ClientId };
            var result = await InvoiceService.GetPagedAsync(1, 100, null, null, null, filter);
            _invoices = result.Items;
        }
        catch
        {
            _invoicesError = "Failed to load invoices.";
        }
        finally
        {
            _invoicesLoading = false;
        }
    }

    private static int GetStatusIndex(string status) => status switch
    {
        StatusStrings.ProjectNotStarted => 0,
        StatusStrings.ProjectInProgress => 1,
        StatusStrings.ProjectCompleted => 2,
        StatusStrings.ProjectOnHold => 3,
        _ => -1
    };

    private async Task UpdateStatusWithConfirm(ProjectStatus newStatus)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, $"Change Status to {newStatus}" },
            { x => x.Message, $"Are you sure you want to change the project status to {newStatus}?" },
            { x => x.ConfirmText, "Change Status" },
            { x => x.Icon, Icons.Material.Filled.SwapHoriz },
            { x => x.Color, Color.Primary }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Change Status", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            try
            {
                await ProjectService.UpdateStatusAsync(Id, newStatus);
                _project = await ProjectService.GetByIdAsync(Id);
                Snackbar.Add($"Project status changed to {newStatus}.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to change status: {ex.Message}", Severity.Error);
            }
        }
    }
}