@page "/receipts/edit/{Id:guid}"
@attribute [Authorize(Policy = PolicyNames.OrgMemberOrAbove)]
@inject IMoneyReceiptService MoneyReceiptService
@inject IInvoiceService InvoiceService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageHeader Title="@(_receiptNumber is null ? "Edit Receipt" : $"Edit: {_receiptNumber}")" Icon="@Icons.Material.Filled.Edit" />

<ErrorAlert Message="@_errorMessage"
            OnDismiss="@(() => _errorMessage = null)" />

@if (_loading)
{
    <LoadingSkeleton Variant="SkeletonVariant.Form" />
}
else if (_receipt is null)
{
    <MudAlert Severity="Severity.Warning" Class="mt-4">Receipt not found.</MudAlert>
}
else
{
    <MudForm @ref="_form" @bind-IsValid="_isValid">
    <FormCard>
        <MudText Typo="Typo.subtitle2" Class="mb-4">Payer Information</MudText>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="EditModel.ReceivedFromName"
                              Label="Received From *"
                              Required="true"
                              RequiredError="Received from is required"
                              For="@(() => EditModel.ReceivedFromName)" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="EditModel.ReceivedFromPan"
                              Label="PAN"
                              For="@(() => EditModel.ReceivedFromPan)" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="EditModel.ReferenceNo"
                              Label="Reference No"
                              For="@(() => EditModel.ReferenceNo)" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="EditModel.ReceivedFromAddress"
                              Label="Address"
                              Lines="2"
                              For="@(() => EditModel.ReceivedFromAddress)" />
            </MudItem>
        </MudGrid>
    </FormCard>

    <FormCard>
        <MudText Typo="Typo.subtitle2" Class="mb-4">Payment Details</MudText>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudSelect @bind-Value="EditModel.PaymentMethod"
                           Label="Payment Method *"
                           Required="true"
                           RequiredError="Payment method is required"
                           For="@(() => EditModel.PaymentMethod)">
                    @foreach (var method in Enum.GetValues<PaymentMethod>())
                    {
                        <MudSelectItem T="PaymentMethod" Value="@method" @key="method">@method.ToString()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="EditModel.Notes"
                              Label="Notes"
                              Lines="2"
                              For="@(() => EditModel.Notes)" />
            </MudItem>
        </MudGrid>
    </FormCard>

    <FormCard>
        <MudText Typo="Typo.subtitle2" Class="mb-4">Allocated Invoices</MudText>

        @if (_loadingInvoices)
        {
            <div class="d-flex align-center mb-4">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <MudText Typo="Typo.body2" Class="text-secondary">Loading invoices...</MudText>
            </div>
        }
        else
        {
            <MudSelect T="Guid?" Label="Add Invoice"
                       Variant="Variant.Outlined"
                       Value="_selectedInvoiceId"
                       ValueChanged="@OnInvoiceSelectionChanged"
                       Clearable="true"
                       FullWidth="true"
                       Class="mb-4">
                @foreach (var inv in _availableInvoices)
                {
                    <MudSelectItem T="Guid?" Value="@inv.Id" @key="inv.Id">@inv.InvoiceNumber - @inv.ClientName (@Currency.Format(inv.Total))</MudSelectItem>
                }
            </MudSelect>

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       Disabled="@(_selectedInvoiceId is null)"
                       OnClick="@AddInvoice">
                Add Invoice
            </MudButton>
        }

        @if (_selectedInvoices.Count > 0)
        {
            <MudTable T="SelectedInvoiceRow" Items="@_selectedInvoices"
                      Dense="true" Hover="true" Outlined="false" Elevation="0" Class="mt-4">
                <HeaderContent>
                    <MudTh>Invoice #</MudTh>
                    <MudTh>Client</MudTh>
                    <MudTh>Total</MudTh>
                    <MudTh>Paid</MudTh>
                    <MudTh>Balance Due</MudTh>
                    <MudTh>Allocating *</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudLink Href="@($"/invoices/{context.InvoiceId}")" Target="_blank">@context.InvoiceNumber</MudLink>
                    </MudTd>
                    <MudTd>@context.ClientName</MudTd>
                    <MudTd>@Currency.Format(context.Total)</MudTd>
                    <MudTd>@Currency.Format(context.AmountPaid)</MudTd>
                    <MudTd>@Currency.Format(context.BalanceDue)</MudTd>
                    <MudTd>
                        <MudNumericField T="decimal"
                                         @bind-Value="context.Allocating"
                                         Min="0.01m"
                                         Max="@(context.BalanceDue + context.Allocating)"
                                         Immediate="true"
                                         Variant="Variant.Outlined"
                                         Class="mud-numeric-field-compact" />
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       Color="Color.Error"
                                       aria-label="Remove invoice"
                                       OnClick="@(() => RemoveInvoice(context.InvoiceId))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="text-secondary mt-4">No invoices selected.</MudText>
        }
    </FormCard>

        <FormActions SaveLabel="Save Changes"
                     CancelHref="@($"/receipts/{Id}")"
                     Disabled="@(!_isValid || _saving)"
                     Saving="@_saving"
                     OnSave="@(async () => await SaveAsync())" />
    </MudForm>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private MudForm _form = null!;
    private bool _isValid;
    private bool _loading = true;
    private bool _saving;
    private bool _loadingInvoices = true;
    private string? _errorMessage;
    private MoneyReceiptDetailDto? _receipt;
    private string? _receiptNumber;
    private EditReceiptModel EditModel { get; set; } = new();
    private Guid? _selectedInvoiceId;
    private List<SelectedInvoiceRow> _selectedInvoices = [];

    private List<InvoiceSelectionDto> _availableInvoices = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _receipt = await MoneyReceiptService.GetByIdAsync(Id);
            _receiptNumber = _receipt?.ReceiptNumber;

            if (_receipt is not null)
            {
                EditModel.ReceivedFromName = _receipt.ReceivedFromName;
                EditModel.ReceivedFromPan = _receipt.ReceivedFromPan;
                EditModel.ReceivedFromAddress = _receipt.ReceivedFromAddress;
                EditModel.PaymentMethod = _receipt.PaymentMethod;
                EditModel.ReferenceNo = _receipt.ReferenceNo;

                foreach (var alloc in _receipt.Allocations)
                {
                    _selectedInvoices.Add(new SelectedInvoiceRow
                    {
                        InvoiceId = alloc.InvoiceId,
                        InvoiceNumber = alloc.InvoiceNumber,
                        ClientName = "",
                        Total = 0,
                        AmountPaid = 0,
                        BalanceDue = 0,
                        Allocating = alloc.AllocatedAmount
                    });
                }
            }

            _availableInvoices = await InvoiceService.GetInvoiceSelectionAsync();

            foreach (var row in _selectedInvoices)
            {
                var inv = _availableInvoices.FirstOrDefault(i => i.Id == row.InvoiceId);
                if (inv is not null)
                {
                    row.InvoiceNumber = inv.InvoiceNumber;
                    row.ClientName = inv.ClientName;
                    row.Total = inv.Total;
                    row.AmountPaid = inv.AmountPaid;
                    row.BalanceDue = inv.Total - inv.AmountPaid;
                }
            }
        }
        catch
        {
            _errorMessage = "Failed to load receipt.";
        }
        finally
        {
            _loadingInvoices = false;
            _loading = false;
        }
    }

    private void OnInvoiceSelectionChanged(Guid? invoiceId)
    {
        if (invoiceId is null) return;
        var inv = _availableInvoices.FirstOrDefault(i => i.Id == invoiceId.Value);
        if (inv is not null && string.IsNullOrWhiteSpace(EditModel.ReceivedFromName))
        {
            EditModel.ReceivedFromName = inv.ClientName;
            EditModel.ReceivedFromPan = inv.ClientPan;
            EditModel.ReceivedFromAddress = inv.ClientAddress;
        }
    }

    private async Task AddInvoice()
    {
        if (_selectedInvoiceId is null) return;

        if (_selectedInvoices.Any(i => i.InvoiceId == _selectedInvoiceId.Value))
        {
            Snackbar.Add("Invoice already selected.", Severity.Warning);
            return;
        }

        var inv = _availableInvoices.FirstOrDefault(i => i.Id == _selectedInvoiceId.Value);
        if (inv is null) return;

        _selectedInvoices.Add(new SelectedInvoiceRow
        {
            InvoiceId = inv.Id,
            InvoiceNumber = inv.InvoiceNumber,
            ClientName = inv.ClientName,
            Total = inv.Total,
            AmountPaid = inv.AmountPaid,
            BalanceDue = inv.Total - inv.AmountPaid,
            Allocating = inv.Total - inv.AmountPaid
        });

        _selectedInvoiceId = null;
    }

    private void RemoveInvoice(Guid invoiceId)
    {
        _selectedInvoices.RemoveAll(i => i.InvoiceId == invoiceId);
    }

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        if (_selectedInvoices.Count == 0 || _selectedInvoices.Sum(i => i.Allocating) <= 0)
        {
            Snackbar.Add("At least one invoice with allocation is required.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var request = new UpdateMoneyReceiptRequest(
                Id,
                _selectedInvoices.Select(i => i.InvoiceId).ToArray(),
                _selectedInvoices.Select(i => i.Allocating).ToArray(),
                EditModel.PaymentMethod,
                EditModel.ReferenceNo,
                EditModel.ReceivedFromName,
                EditModel.ReceivedFromPan,
                EditModel.ReceivedFromAddress,
                EditModel.Notes);

            await MoneyReceiptService.UpdateAsync(request);
            Snackbar.Add("Receipt updated.", Severity.Success);
            Navigation.NavigateTo($"/receipts/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to update receipt: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private class EditReceiptModel
    {
        public PaymentMethod PaymentMethod { get; set; } = PaymentMethod.BankTransfer;
        public string ReceivedFromName { get; set; } = string.Empty;
        public string? ReceivedFromPan { get; set; }
        public string? ReceivedFromAddress { get; set; }
        public string? ReferenceNo { get; set; }
        public string Notes { get; set; } = string.Empty;
    }

    private class SelectedInvoiceRow
    {
        public Guid InvoiceId { get; set; }
        public string InvoiceNumber { get; set; } = string.Empty;
        public string ClientName { get; set; } = string.Empty;
        public decimal Total { get; set; }
        public decimal AmountPaid { get; set; }
        public decimal BalanceDue { get; set; }
        public decimal Allocating { get; set; }
    }
}
