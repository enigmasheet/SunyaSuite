<MudChip T="string" Size="@Size" Color="@ResolvedColor" Class="@Class">
    @Symbol @ChildContent
</MudChip>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Small;
    [Parameter] public string? Status { get; set; }

    private string Symbol => Status switch
    {
        StatusStrings.ClientGreen or StatusStrings.InvoicePaid or StatusStrings.ProjectCompleted => "\u2713 ",
        StatusStrings.ClientYellow or StatusStrings.InvoiceSent or StatusStrings.ProjectInProgress => "\u2192 ",
        StatusStrings.ClientRed or StatusStrings.InvoiceOverdue or StatusStrings.ProjectOnHold => "\u26a0 ",
        _ => "\u25cb "
    };

    private Color ResolvedColor => Status switch
    {
        StatusStrings.ClientGreen or StatusStrings.InvoicePaid or StatusStrings.ProjectCompleted => Color.Success,
        StatusStrings.ClientYellow or StatusStrings.ProjectOnHold => Color.Warning,
        StatusStrings.ClientRed or StatusStrings.InvoiceOverdue => Color.Error,
        StatusStrings.InvoiceSent or StatusStrings.ProjectInProgress => Color.Info,
        _ => Color.Default
    };
}
